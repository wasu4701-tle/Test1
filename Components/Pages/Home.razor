using  System ; 
using  System.Collections.Generic ; 
using  System.Text ; 
class Program
 { 
     static  void Main ( string [ ] args ) 
      { 
           while  ( true ) 
            { 
                int randno = Newnum ( 1 , 101 ) ; 
                int count =  1 ; 
                while  ( true ) 
                { 
                    Console.Write ( " ป้อนตัวเลขระหว่าง 1 ถึง 100 (0 เพื่อออก):" ) ; int input = Convert.ToInt32 ( Console.ReadLine ( ) ) ; if ( input == 0 ) return ; else if ( input < randno ) { Console.WriteLine ( " 
                        ต่ำลองอีกครั้ง" ) ; ++ count ; continue ; } else if ( input > randno ) { 
                        Console.WriteLine ( " สูง ลองอีกครั้ง" ) ; ++ count ; continue ; } else { 
                        Console . WriteLine ( "คุณเดาถูกแล้ว! ตัวเลขคือ {0}!" ,
                    
                                  
                                           randno ) ; 
                        Console . WriteLine ( "It took you {0} {1}. \n " , count,
                                           count ==  1  ?  "try"  :  "tries" ) ; 
                        break ; 
                    } 
                } 
            }
 
        } 
        static  int Newnum ( int min, int max ) 
        { 
            Random random =  new Random ( ) ; 
            return random . Next ( min, max ) ; 
        } 
    } 
}
